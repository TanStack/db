diff --git a/packages/shared-internals/src/utils/map.ts b/packages/shared-internals/src/utils/map.ts
new file mode 100644
index 0000000..b2a5161
--- /dev/null
+++ b/packages/shared-internals/src/utils/map.ts
@@ -0,0 +1,8 @@
+/** Returns an existing entry, computing and storing a value only for a missing key. */
+export function getOrCreate<K, V>(map: Map<K, V>, key: K, create: (key: K) => V): V {
+  // A stored undefined is still an entry and must not invoke create again.
+  if (map.has(key)) return map.get(key)!;
+  const value = create(key);
+  map.set(key, value);
+  return value;
+}
diff --git a/packages/shared-internals/tests/standalone-compatibility.test.ts b/packages/shared-internals/tests/standalone-compatibility.test.ts
