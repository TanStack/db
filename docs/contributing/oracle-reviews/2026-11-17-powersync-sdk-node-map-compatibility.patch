--- /dev/null
+++ b/packages/shared-internals/tests/standalone-compatibility.test.ts
@@ -0,0 +1,19 @@
+import { expect, test } from 'vitest';
+import { DownloadClientState, LocalWriteState } from '../src/standalone/client_state.js';
+
+// Keep this outside tests/standalone: that directory is skipped on Node < 26.
+// A complete checkpoint exercises bucket, row, per-bucket and per-table maps.
+test('applies a standalone checkpoint on maintained Node runtimes without polyfills', () => {
+  const state = new DownloadClientState(new LocalWriteState());
+  state.push({ checkpoint: { last_op_id: '1', buckets: [{ bucket: 'bucket', checksum: 0 }] } });
+  state.push({
+    data: {
+      bucket: 'bucket',
+      data: [{ op: 'PUT', op_id: '1', checksum: 0, object_type: 'items', object_id: 'row', data: '{"value":1}' }]
+    }
+  });
+
+  expect(state.push({ checkpoint_complete: { last_op_id: '1' } })).toStrictEqual([
+    { type: 'rows', changes: { updatedRows: new Map([['items', new Map([['row', { value: 1 }]])]]) } }
+  ]);
+});
diff --git a/packages/shared-internals/tests/utils/map.test.ts b/packages/shared-internals/tests/utils/map.test.ts
new file mode 100644
index 0000000..c31401f
--- /dev/null
+++ b/packages/shared-internals/tests/utils/map.test.ts
@@ -0,0 +1,45 @@
+import { expect, test, vi } from 'vitest';
+import { getOrCreate } from '../../src/utils/map.js';
+
+test('computes a missing entry once and reuses its identity', () => {
+  const key = {};
+  const value = {};
+  const entries = new Map<object, object>();
+  const create = vi.fn(() => value);
+
+  expect(getOrCreate(entries, key, create)).toBe(value);
+  expect(getOrCreate(entries, key, create)).toBe(value);
+  expect(entries.get(key)).toBe(value);
+  expect(create).toHaveBeenCalledExactlyOnceWith(key);
+});
+
+test('preserves a stored undefined without computing a replacement', () => {
+  const entries = new Map<string, string | undefined>([['key', undefined]]);
+  const create = vi.fn(() => 'replacement');
+
+  expect(getOrCreate(entries, 'key', create)).toBeUndefined();
+  expect(entries.has('key')).toBe(true);
+  expect(create).not.toHaveBeenCalled();
+});
+
+test('stores a computed undefined without computing it again', () => {
+  const entries = new Map<string, undefined>();
+  const create = vi.fn(() => undefined);
+
+  expect(getOrCreate(entries, 'key', create)).toBeUndefined();
+  expect(getOrCreate(entries, 'key', create)).toBeUndefined();
+  expect(entries.has('key')).toBe(true);
+  expect(create).toHaveBeenCalledOnce();
+});
+
+test('does not insert an entry when its factory throws', () => {
+  const entries = new Map<string, number>();
+  const error = new Error('creation failed');
+
+  expect(() =>
+    getOrCreate(entries, 'key', () => {
+      throw error;
+    })
+  ).toThrow(error);
+  expect(entries.has('key')).toBe(false);
+});
