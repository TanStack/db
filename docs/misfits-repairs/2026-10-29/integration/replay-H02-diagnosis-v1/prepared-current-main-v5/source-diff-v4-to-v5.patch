+          typeof value !== `object` ||
+          value === null ||
+          !(`h02` in value) ||
+          value.h02 !== true ||
+          !(`phase` in value) ||
+          typeof value.phase !== `string` ||
+          !value.phase ||
+          !(`sequence` in value) ||
+          !Number.isSafeInteger(value.sequence) ||
+          value.sequence !== sequence + 1
