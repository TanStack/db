+        accept(/** @type {Receipt} */ (value))
+        offset = end + 1
+      }
+      fragment = Buffer.from(bytes.subarray(offset))
+    },
+    finish() {
+      if (fragment.length)
+        throw new Error(`truncated final receipt: ${fragment.length} bytes`)
+      if (sequence === 0) throw new Error(`receipt stream is empty`)
+      return sequence
+    },
+  }
+}
