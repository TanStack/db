{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git"
  },
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:minified": "pnpm --filter \"./packages/**\" build:minified",
    "changeset": "changeset",
    "changeset:publish": "node scripts/publish-packages.mjs",
    "changeset:version": "node scripts/version-packages.mjs",
    "format": "prettier --experimental-cli --ignore-unknown '**/*' --write",
    "lint": "pnpm --filter \"./packages/**\" lint",
    "lint:check": "pnpm --filter \"./packages/**\" lint --fix=false",
    "lint:changed": "node scripts/agent-lint-feedback.mjs",
    "lint:oracles": "node scripts/agent-lint-feedback.mjs --all",
    "lint:run-budgets": "node scripts/check-oracle-run-counts.mjs",
    "gap-report": "oracle-gaps --env-prefix TANSTACK_DB_ORACLE",
    "test:lint-rules": "vitest run --config scripts/oracle-scripts.vitest.config.mjs",
    "lint-all": "eslint . --fix",
    "prepare": "husky",
    "test": "pnpm --filter \"./packages/**\" test && pnpm --filter @tanstack/db test:indexed-db:package",
    "test:oracles": "pnpm --filter @tanstack/db test:oracles && pnpm --filter @tanstack/query-db-collection test:oracles && pnpm --filter @tanstack/db test:indexed-db:oracles && pnpm --filter @tanstack/db-sqlite-persistence-core test:oracles && pnpm --filter @tanstack/browser-db-sqlite-persistence test:oracles",
    "test:minified-db": "node scripts/test-minified-db.mjs",
    "test:ssr-bundle": "node scripts/ssr-bundle-oracle.mjs",
    "test:production-errors": "node scripts/test-production-errors.mjs",
    "test:release": "node --test scripts/version-packages.test.mjs scripts/publish-packages.test.mjs && vitest run --config scripts/oracle-scripts.vitest.config.mjs scripts/release-comments-oracle.property.test.js",
    "check:mangle": "node scripts/mangle-private-members.mjs",
    "size:compare": "node scripts/size-compare.mjs",
    "typecheck:tests": "pnpm --filter @tanstack/db-ivm --filter @tanstack/offline-transactions typecheck",
    "test:docs": "node scripts/verify-links.ts",
    "test:doc-snippets": "node scripts/check-doc-snippets.mjs",
    "test:sherif": "sherif -i zod -p offline-transactions-react-native -p shopping-list-react-native",
    "generate-docs": "node scripts/generate-error-docs.mjs && node scripts/generate-docs.ts"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "7.1.1",
    "@changesets/assemble-release-plan": "6.0.10",
    "@changesets/cli": "^2.31.1",
    "@changesets/config": "3.1.4",
    "@changesets/get-release-plan": "4.0.16",
    "@changesets/read": "0.6.7",
    "@eslint/js": "^9.39.5",
    "@fast-check/vitest": "^0.5.0",
    "@manypkg/get-packages": "1.1.3",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tanstack/eslint-config": "0.3.4",
    "@tanstack/eslint-plugin-oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/eslint-plugin-oracles@f8a58a3",
    "@tanstack/oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/oracles@f8a58a3",
    "@tanstack/typedoc-config": "0.3.5",
    "@tanstack/vite-config": "0.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "markdown-link-extractor": "^4.0.4",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "sherif": "^1.13.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
