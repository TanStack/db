{
  "name": "offline-first-electron",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "concurrently \"pnpm dev:renderer\" \"pnpm dev:server\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:electron": "wait-on http://localhost:5173 && pnpm rebuild:electron && electron .",
    "server": "tsx server/index.ts",
    "rebuild:electron": "electron-rebuild --force --only better-sqlite3 --module-dir ."
  },
  "dependencies": {
    "@tanstack/electron-db-sqlite-persistence": "^1.0.0-rc.1.4",
    "@tanstack/node-db-sqlite-persistence": "^1.0.0-rc.1.4",
    "@tanstack/offline-transactions": "^1.2.0",
    "@tanstack/query-db-collection": "^1.5.1",
    "@tanstack/react-db": "^1.0.0-rc.1.4",
    "@tanstack/react-query": "^5.107.1",
    "better-sqlite3": "^12.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.5",
    "cors": "^2.8.6",
    "electron": "^42.11.18",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "wait-on": "^8.0.5"
  }
}
