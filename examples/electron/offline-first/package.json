{
  "name": "offline-first-electron",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "concurrently \"pnpm dev:renderer\" \"pnpm dev:server\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "server": "tsx server/index.ts",
    "postinstall": "prebuild-install --runtime electron --target 41.0.0 --arch arm64 || echo 'prebuild-install failed, try: npx @electron/rebuild'"
  },
  "dependencies": {
    "@tanstack/electron-db-sqlite-persistence": "^1.0.0-rc.1.1",
    "@tanstack/node-db-sqlite-persistence": "^1.0.0-rc.1.1",
    "@tanstack/offline-transactions": "^1.2.0",
    "@tanstack/query-db-collection": "^1.5.0",
    "@tanstack/react-db": "^1.0.0-rc.1.1",
    "@tanstack/react-query": "^5.90.20",
    "better-sqlite3": "^12.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "electron": "^42.0.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "wait-on": "^8.0.3"
  }
}
