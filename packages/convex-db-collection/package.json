{
  "name": "@tanstack/convex-db-collection",
  "version": "0.1.0",
  "description": "Convex collection for TanStack DB",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git",
    "directory": "packages/convex-db-collection"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "convex",
    "tanstack",
    "optimistic",
    "typescript"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:oracles": "vitest run tests/snapshot-oracle.property.test.ts tests/ownership-oracle.property.test.ts tests/pagination-oracle.property.test.ts tests/offline-oracle.property.test.ts tests/values-oracle.property.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./offline": {
      "import": {
        "types": "./dist/esm/offline.d.ts",
        "default": "./dist/esm/offline.js"
      },
      "require": {
        "types": "./dist/cjs/offline.d.cts",
        "default": "./dist/cjs/offline.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/db": "workspace:*",
    "@tanstack/offline-transactions": "workspace:*"
  },
  "peerDependencies": {
    "convex": "^1.47.0",
    "typescript": ">=4.7"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^3.2.4",
    "convex": "^1.47.0"
  }
}
