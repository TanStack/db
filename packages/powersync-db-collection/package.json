{
  "name": "@tanstack/powersync-db-collection",
  "version": "1.0.0-rc.1.5",
  "description": "PowerSync collection for TanStack DB",
  "author": "POWERSYNC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git",
    "directory": "packages/powersync-db-collection"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "powersync",
    "realtime",
    "local-first",
    "sync-engine",
    "sync",
    "replication",
    "opfs",
    "indexeddb",
    "localstorage",
    "optimistic",
    "typescript"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest --run",
    "test:oracles": "vitest run --coverage.enabled=false tests/batch-decode-conformance-oracle.property.test.ts tests/demand-union-conformance-oracle.property.test.ts tests/eager-live-source-conformance-oracle.property.test.ts tests/eager-reload-conformance-oracle.property.test.ts tests/hook-lifecycle-conformance-oracle.property.test.ts tests/initial-receipt-conformance-oracle.property.test.ts tests/persisted-baseline-lifecycle-oracle.test.ts tests/persisted-capability-conformance-oracle.test.ts tests/persisted-startup-conformance-oracle.property.test.ts"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/db": "workspace:*",
    "@tanstack/store": "^0.11.2",
    "debug": "^4.4.3",
    "p-defer": "^4.0.1"
  },
  "peerDependencies": {
    "@powersync/common": "^2.0.0"
  },
  "devDependencies": {
    "@powersync/common": "2.5.0",
    "@powersync/node": "0.21.0",
    "@powersync/web": "2.6.0",
    "@types/debug": "^4.1.13",
    "@vitest/coverage-istanbul": "^5.1.0",
    "better-sqlite3": "^12.11.1"
  }
}
