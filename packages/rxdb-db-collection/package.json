{
  "name": "@tanstack/rxdb-db-collection",
  "version": "1.0.0-rc.1.6",
  "description": "Reactive, Offline-First adapter for TanStack DB using RxDB. Sync, Replication and Local-First support.",
  "author": "Kyle Mathews",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git",
    "directory": "packages/rxdb-db-collection"
  },
  "bugs": {
    "url": "https://github.com/TanStack/db/issues"
  },
  "homepage": "https://tanstack.com/db/latest/docs/collections/rxdb-collection",
  "keywords": [
    "rxdb",
    "tanstack",
    "tanstack-db",
    "nosql",
    "realtime",
    "local-first",
    "offline-first",
    "offline",
    "pwa",
    "reactive",
    "database",
    "sync-engine",
    "sync",
    "replication",
    "opfs",
    "indexeddb",
    "localstorage",
    "optimistic"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest --run",
    "test:oracles": "vitest run --coverage.enabled=false tests/eager-gate-conformance-oracle.property.test.ts tests/eager-live-source-conformance-oracle.property.test.ts tests/eager-reload-conformance-oracle.property.test.ts tests/initial-receipt-oracle.property.test.ts tests/mutation-source-batch-oracle.property.test.ts tests/persisted-baseline-lifecycle-oracle.test.ts tests/persisted-capability-conformance-oracle.test.ts tests/persisted-initial-receipt-oracle.property.test.ts tests/persisted-startup-conformance-oracle.property.test.ts tests/shared-client-oracle.property.test.ts",
    "test:oracles:browser": "vitest run --config vitest.browser-oracles.config.ts"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/db": "workspace:*",
    "@tanstack/store": "^0.11.2",
    "debug": "^4.4.3",
    "rxdb": "17.6.0"
  },
  "peerDependencies": {
    "rxdb": ">=17.0.0",
    "rxjs": ">=7.8.2",
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@vitest/coverage-istanbul": "^5.1.0"
  }
}
