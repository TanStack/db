{
  "name": "@tanstack/supabase-db-collection",
  "private": true,
  "version": "0.0.0",
  "description": "Supabase collection for TanStack DB",
  "author": "Supabase <support@supabase.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git",
    "directory": "packages/supabase-db-collection"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "supabase",
    "postgrest",
    "realtime",
    "optimistic",
    "typescript"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest run"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@supabase/postgrest-js": "^2.107.0",
    "@tanstack/db": "workspace:*",
    "@tanstack/query-db-collection": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.74.0",
    "@tanstack/query-core": "^5.90.15",
    "typescript": ">=4.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/query-core": "^5.107.1",
    "@vitest/coverage-istanbul": "^5.1.0",
    "zod": "^4.6.7"
  }
}
